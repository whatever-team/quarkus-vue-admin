{
  "name": "vue-antd-admin",
  "version": "0.7.4",
  "homepage": "https://iczer.github.io/vue-antd-admin",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint",
    "predeploy": "yarn build",
    "deploy": "gh-pages -d dist -b pages -r https://gitee.com/iczer/vue-antd-admin.git",
    "docs:dev": "vuepress dev docs",
    "docs:build": "vuepress build docs",
    "docs:deploy": "vuepress build docs && gh-pages -d docs/.vuepress/dist -b master -r https://gitee.com/iczer/vue-antd-admin-docs.git"
  },
  "dependencies": {
    "@antv/data-set": "^0.11.8",
    "animate.css": "^4.1.1",
    "ant-design-vue": "^1.7.8",
    "axios": "^1.13.2",
    "clipboard": "^2.0.11",
    "core-js": "^3.47.0",
    "date-fns": "^4.1.0",
    "enquire.js": "^2.1.6",
    "highlight.js": "^11.11.1",
    "js-cookie": "^3.0.5",
    "mockjs": "^1.1.0",
    "nprogress": "^0.2.0",
    "viser-vue": "^2.4.8",
    "vue": "^2.7.16",
    "vue-i18n": "^8.28.2",
    "vue-router": "^3.6.5",
    "vuedraggable": "^2.24.3",
    "vuex": "^3.6.2"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.26.8",
    "@ant-design/colors": "^7.2.1",
    "@vue/cli-plugin-babel": "^5.0.9",
    "@vue/cli-plugin-eslint": "^5.0.9",
    "@vue/cli-service": "^5.0.9",
    "@vuepress/plugin-back-to-top": "^1.9.10",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-polyfill": "^6.26.0",
    "compression-webpack-plugin": "^11.1.0",
    "deepmerge": "^4.3.1",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^10.6.2",
    "fast-deep-equal": "^3.1.3",
    "gh-pages": "^6.3.0",
    "less-loader": "^12.3.0",
    "style-resources-loader": "^1.5.0",
    "vue-cli-plugin-style-resources-loader": "^0.1.5",
    "vue-template-compiler": "^2.7.16",
    "vuepress": "^1.9.10",
    "webpack-theme-color-replacer": "1.5.5",
    "whatwg-fetch": "^3.6.20"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser",
      "requireConfigFile": false
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 10"
  ]
}
